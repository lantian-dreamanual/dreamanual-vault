# 依赖与构建产物
node_modules/
dist/
# 避开删除守卫时会把 dist 整个 mv 成 dist.bak-<时间戳>（vite 清空 dist 会被拦，
# 且抛错前已经删了一半）。那是临时产物，别提交。
# 注意 `dist/` 这条匹配不到它 —— 目录名不是 `dist`。
dist.bak-*/
# 不带前缀斜杠：这样 `target/` 在任意层级都命中。
# 写成 `src-tauri/target/` 只锚定仓库根下那一个，M0 壳里的
# `app/src-tauri/target/`（767 MB）会被照单收进提交。
target/
src-tauri/gen/

# M0 的验证壳。根工程已取代它，壳里只剩一个 Rust 构建目录与一份
# 被后来的实现推翻的最小界面，跟着公开仓库走只会让读者以为它是当前实现。
app/

# 开发期的库文件目录。放在仓库里而不是正式位置，
# 是为了让自动化验收反复建库、改库时不碰到真实凭据（见 src-tauri/src/vault.rs）。
.dev-home/

# 截图产物（scripts/shots.sh 的输出）
spike/out/

# 智能体的工作记忆。里面记着本机路径、NAS 目录名与个人习惯，
# 仓库是公开的，这些不进版本控制。
.workbuddy/

# 设计文档与原型。PRD 里写着本机的数据目录、备份盘路径与真实条目示例，
# 属于个人信息，不跟着公开仓库走。
密码保险箱原型/

# macOS
.DS_Store

# Python 字节码（scripts/*.py 跑过一次就会生成）
__pycache__/
